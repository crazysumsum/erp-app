      "id": "lint",
      "kind": "LINT",
      "argv": [
        "npm",
        "run",
        "lint"
      ],
      "cwd": ".",
      "timeout_seconds": 1800,
      "result_adapter": "EXIT_CODE",
      "result_path": "lint-result.json",
      "min_tests": 0,
      "max_skipped": 0,
      "stages": [
        "DEVELOPER"
      ],
      "required_case_ids": [],
      "tool_probes": [
        {
          "argv": [
            "node",
            "--version"
          ],
          "version_pattern": "^v26\\."
        }
      ],
      "side_effects": [
        "FILES"
      ],
      "env_keys": [],
      "redaction_env_keys": [
        "DB_PASSWORD"
      ]
    },
    {
      "id": "client-build",
