{
  "schema_version": "2.0",
  "module_id": "customer-management",
  "environment": {
    "id": "customer-isolated-test",
    "kind": "LOCAL_ISOLATED",
    "data_reference": "Synthetic Customer/PII/bank/file/import fixtures defined in 06_technical_test_cases.md; no production data",
    "authorization_ref": null
  },
  "permissions": {
    "product_write": [
      "IMPLEMENT"
    ],
    "test_script_write": [
      "IMPLEMENT",
      "TEST_AND_VERIFY"
    ],
    "docs_write": [
      "DESIGN_AND_PLAN",
      "IMPLEMENT",
      "TEST_AND_VERIFY",
      "REVIEW_AND_ALIGN"
    ],
    "isolated_data_write": [
      "IMPLEMENT",
      "TEST_AND_VERIFY"
    ],
    "schema_execute": [
      "IMPLEMENT"
    ],
    "deployment": [],
    "external_effects": [],
    "evidence_export": []
  },
  "runtime_policy": {
    "strategy": "ISOLATED",
    "required_resources": [
      "workspace",
      "mysql-schema",
      "customer-file-root",
      "customer-import-root",
      "web-port"
    ],
    "cleanup_owner": "Executing Phase owner"
  },
