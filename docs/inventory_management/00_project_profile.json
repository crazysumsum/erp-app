{
  "schema_version": "2.0",
  "module_id": "inventory-management",
  "environment": {
    "id": "inventory-isolated-test",
    "kind": "LOCAL_ISOLATED",
    "data_reference": "Synthetic Inventory fixtures defined in 06_technical_test_cases.md; no production data",
    "authorization_ref": "APR-055 (Sam approved P1 developer gates on isolated resources); APR-042 (Sam approved disposable MySQL 26.7.0)"
  },
  "permissions": {
    "product_write": [
      "IMPLEMENT"
    ],
    "test_script_write": [
      "IMPLEMENT",
      "TEST_AND_VERIFY"
    ],
    "docs_write": [
      "DESIGN_AND_PLAN",
      "IMPLEMENT",
      "TEST_AND_VERIFY",
      "REVIEW_AND_ALIGN"
    ],
    "isolated_data_write": [
      "IMPLEMENT",
      "TEST_AND_VERIFY"
    ],
    "schema_execute": [
      "IMPLEMENT"
    ],
    "deployment": [],
    "external_effects": [],
    "evidence_export": []
  },
  "runtime_policy": {
    "strategy": "ISOLATED",
    "required_resources": [
      "workspace",
      "mysql-schema",
      "web-port",
      "opening-file-root"
    ],
    "cleanup_owner": "Executing Phase owner"
  },
  "suites": [
    {
      "id": "lint",
      "kind": "LINT",
      "argv": [
        "npm",
        "run",
        "lint"
      ],
      "cwd": ".",
      "timeout_seconds": 600,
      "result_adapter": "EXIT_CODE",
      "result_path": "lint-result.json",
      "min_tests": 0,
      "max_skipped": 0,
      "stages": [
        "DEVELOPER"
      ],
      "required_case_ids": [],
      "tool_probes": [
        {
          "argv": [
            "node",
            "--version"
          ],
          "version_pattern": "^v26\\."
        }
      ],
      "side_effects": [
        "FILES"
      ],
      "env_keys": [],
      "redaction_env_keys": [
        "DB_PASSWORD"
      ]
    },
    {
      "id": "client-build",
      "kind": "BUILD",
      "argv": [
        "npm",
        "run",
        "build",
        "--workspace",
        "client"
      ],
      "cwd": ".",
      "timeout_seconds": 900,
      "result_adapter": "EXIT_CODE",
      "result_path": "client-build-result.json",
      "min_tests": 0,
      "max_skipped": 0,
      "stages": [
        "DEVELOPER"
      ],
      "required_case_ids": [],
      "tool_probes": [
        {
          "argv": [
            "node",
            "--version"
          ],
          "version_pattern": "^v26\\."
        }
      ],
      "side_effects": [
        "FILES"
      ],
      "env_keys": [],
      "redaction_env_keys": [
        "DB_PASSWORD"
      ]
    },
    {
      "id": "inventory-developer",
      "kind": "UNIT",
      "argv": [
        "node",
        "--test",
        "--import",
        "./server/test-support/testEnv.js",
        "--test-reporter=junit",
        "--test-reporter-destination={run_dir}/inventory-developer.xml",
        "server/test/inventoryAllocationHandlers.test.js",
        "server/test/inventoryAllocationTransitions.test.js",
        "server/test/inventoryAuditService.test.js",
        "server/test/inventoryConfig.test.js",
        "server/test/inventoryEndpointSecurity.test.js",
        "server/test/inventoryExpiry.test.js",
        "server/test/inventoryFoundation.test.js",
        "server/test/inventoryInquiryHandlers.test.js",
        "server/test/inventoryInquiryService.test.js",
        "server/test/inventoryIssueService.test.js",
        "server/test/inventoryLockService.test.js",
        "server/test/inventoryMasterHandlers.test.js",
        "server/test/inventoryMasterMigration.test.js",
        "server/test/inventoryMasterService.test.js",
        "server/test/inventoryOperationHash.test.js",
        "server/test/inventoryOperationService.test.js",
        "server/test/inventoryPickSequence.test.js",
        "server/test/inventoryPostingHandlers.test.js",
        "server/test/inventoryPostingService.test.js",
        "server/test/inventoryProjections.test.js",
        "server/test/inventoryProviderContracts.test.js",
        "server/test/inventoryQuantity.test.js",
        "server/test/inventoryReservationHandlers.test.js",
        "server/test/inventoryReservationInquiryHandlers.test.js",
        "server/test/inventoryReservationService.test.js",
        "server/test/inventoryTestSupport.test.js",
        "server/test/inventoryValidation.test.js"
      ],
      "cwd": ".",
      "timeout_seconds": 600,
      "result_adapter": "JUNIT",
      "result_path": "inventory-developer.xml",
      "min_tests": 108,
      "max_skipped": 0,
      "stages": [
        "DEVELOPER"
      ],
      "required_case_ids": [],
      "tool_probes": [
        {
          "argv": [
            "node",
            "--version"
          ],
          "version_pattern": "^v26\\."
        }
      ],
      "side_effects": [
        "FILES"
      ],
      "env_keys": [],
      "redaction_env_keys": [
        "DB_PASSWORD"
      ]
    },
    {
      "id": "inventory-p2-database",
      "kind": "INTEGRATION",
      "argv": [
        "node",
        "--test",
        "--import",
        "./server/test-support/testEnv.js",
        "--test-reporter=junit",
        "--test-reporter-destination={run_dir}/inventory-p2-database.xml",
        "server/test/integration/inventoryTask022.integration.test.js"
      ],
      "cwd": ".",
      "timeout_seconds": 600,
      "result_adapter": "JUNIT",
      "result_path": "inventory-p2-database.xml",
      "min_tests": 7,
      "max_skipped": 0,
      "stages": [
        "DEVELOPER"
      ],
      "required_case_ids": [],
      "tool_probes": [
        {
          "argv": ["mysql", "--version"],
          "version_pattern": "(?i)(mysql.*26\\.7\\.0|26\\.7\\.0.*mysql)"
        }
      ],
      "side_effects": ["FILES", "ISOLATED_DATA"],
      "env_keys": ["DB_NAME", "DB_SOCKET", "DB_INTEGRATION_TESTS", "INVENTORY_TASK025_TESTS"],
      "redaction_env_keys": []
    },
    {
      "id": "inventory-p2-api",
      "kind": "INTEGRATION",
      "argv": [
        "node",
        "--test",
        "--import",
        "./server/test-support/testEnv.js",
        "--test-reporter=junit",
        "--test-reporter-destination={run_dir}/inventory-p2-api.xml",
        "server/test/integration/inventoryTask025Api.integration.test.js"
      ],
      "cwd": ".",
      "timeout_seconds": 900,
      "result_adapter": "JUNIT",
      "result_path": "inventory-p2-api.xml",
      "min_tests": 1,
      "max_skipped": 0,
      "stages": [
        "DEVELOPER"
      ],
      "required_case_ids": [],
      "tool_probes": [
        {
          "argv": ["mysql", "--version"],
          "version_pattern": "(?i)(mysql.*26\\.7\\.0|26\\.7\\.0.*mysql)"
        }
      ],
      "side_effects": ["FILES", "ISOLATED_DATA"],
      "env_keys": ["DB_NAME", "DB_SOCKET_PATH", "DB_USER", "DB_PASSWORD", "DB_INTEGRATION_TESTS", "INVENTORY_TASK025_API_TESTS", "SUPPLIER_BANK_ACTIVE_KEY_ID", "SUPPLIER_BANK_ENCRYPTION_KEYS", "SUPPLIER_BANK_LOOKUP_ACTIVE_KEY_ID", "SUPPLIER_BANK_LOOKUP_KEYS", "CUSTOMER_BANK_ACTIVE_KEY_ID", "CUSTOMER_BANK_ENCRYPTION_KEYS", "CUSTOMER_BANK_LOOKUP_ACTIVE_KEY_ID", "CUSTOMER_BANK_LOOKUP_KEYS"],
      "redaction_env_keys": ["DB_PASSWORD", "SUPPLIER_BANK_ENCRYPTION_KEYS", "SUPPLIER_BANK_LOOKUP_KEYS", "CUSTOMER_BANK_ENCRYPTION_KEYS", "CUSTOMER_BANK_LOOKUP_KEYS"]
    },
    {
      "id": "inventory-technical",
      "kind": "INTEGRATION",
      "argv": [
        "node",
        "--test",
        "--import",
        "./server/test-support/testEnv.js",
        "--test-reporter=junit",
        "--test-reporter-destination={run_dir}/inventory-technical.xml",
        "server/test"
      ],
      "cwd": ".",
      "timeout_seconds": 3600,
      "result_adapter": "JUNIT",
      "result_path": "inventory-technical.xml",
      "min_tests": 1,
      "max_skipped": 0,
      "stages": [
        "DEVELOPER",
        "TECHNICAL",
        "REGRESSION"
      ],
      "required_case_ids": [
        "TC-001",
        "TC-002",
        "TC-003",
        "TC-004",
        "TC-005",
        "TC-006",
        "TC-007",
        "TC-008",
        "TC-009",
        "TC-010"
      ],
      "tool_probes": [
        {
          "argv": [
            "node",
            "--version"
          ],
          "version_pattern": "^v26\\."
        },
        {
          "argv": [
            "mysql",
            "--version"
          ],
          "version_pattern": "(?i)(mysql.*26\\.7\\.0|26\\.7\\.0.*mysql)"
        }
      ],
      "side_effects": [
        "FILES",
        "ISOLATED_DATA"
      ],
      "env_keys": [
        "DB_HOST",
        "DB_PORT",
        "DB_USER",
        "DB_PASSWORD",
        "DB_NAME",
        "DB_INTEGRATION_TESTS"
      ],
      "redaction_env_keys": [
        "DB_PASSWORD"
      ]
    }
  ],
  "ci": {
    "provider": "GitHub Actions (.github/workflows/ci.yml)",
    "required_checks": [
      "Dependency audit",
      "Lint",
      "Browser tests (Playwright)",
      "Test (server + client, MySQL integration)",
      "Build frontend"
    ]
  },
  "acceptance": {
    "business_required": true,
    "release_approval_required": true,
    "require_clean_candidate": true
  },
  "evidence": {
    "directory": "evidence",
    "max_report_bytes": 2097152,
    "allow_export": false
  }
}
