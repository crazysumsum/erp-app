  "consumer_native_names": {
    "server/test/inventorySalesWorkerContracts.test.js": [
      "Backorder worker requires live fixed registration and DB-clock lease before any claim, including replay",
      "Backorder worker rejects human/arbitrary identity, extra authority and source input",
      "Backorder completed replay uses distinct worker hashes and exact original members without mutable ATP reads"
    ],
    "server/test/integration/salesConfirmation.integration.test.js": [
      "TC-022 Phase A commits one durable original-user intent/DB-clock lease/history/audit without Inventory effects",
      "TC-022 Phase A chooses one intent under concurrent distinct events and blocks second confirmation",
      "TC-022 Phase A stale version rolls back the claim and replay rechecks real revoked permissions",
      "TC-022 Phase A required audit failure rolls back operation, CONFIRMING and history atomically",
      "TC-021 Phase B confirms full, partial and zero ATP with exact mapping/backorder and stable replay",
      "TC-024 Phase B rejects newly inactive Customer and commits Draft/FAILED without Inventory effects",
      "TC-023 multi-line failure rolls back every commitment before retry commits all snapshots",
      "TC-024 credit ON_HOLD fails atomically while a configured limit is advisory",
      "TC-021 technical audit failure and malformed real provider result roll back all Inventory/Sales effects",
      "TC-024 invalid SKU/UOM/Warehouse revalidation safely returns Draft with no Inventory claims",
      "TC-026 confirmation exposes uncertain Phase A COMMIT and reconciles actual commit versus rollback by original event",
      "TC-022 operation lookup requires current original-user permissions and hides another actor's event",
      "TC-022 polling reads committed IN_PROGRESS without waiting for the executing operation lock",
      "TC-022 actual Confirm HTTP schema returns terminal detail and rejects type/identity injection",
      "TC-022 actual HTTP202 retains event/Retry-After and remains pollable before native Phase B commit"
    ],
    "server/test/integration/salesBackorder.integration.test.js": [
      "TC-031 Inventory worker native partial membership replay and fresh lease remain inside the caller rollback",
      "TC-027 FIFO allocates oldest partial demand, blocks later due entry behind cooldown and wakes whole scope without priority mutation",
      "TC-031 zero ATP delays queue metadata only and stale zero-demand queue becomes terminal without Inventory",
      "TC-031 native allocation faults and authority changes roll back every Sales/Inventory projection",
      "TC-031 native lost COMMIT acknowledgement reconciles the persisted original allocation event once",
      "TC-031 native proven rollback permits a new allocation event without preserving a fictitious effect",
      "TC-027 true overlapping allocators fence one FIFO head and cannot over-reserve ATP",
      "TC-031 concurrent cancellation observes allocation version then safely releases the worker mapping",
      "TC-031 technical retry persists bounded exponential cooldown across a new allocator and manual wake cannot bypass FIFO",
      "TC-031 actual registered Scheduler runtime uses SQL cluster admission, overlap and the NULL reserve-only actor",
      "TC-031 real Scheduler shutdown aborts an in-flight Inventory allocation, preserves FIFO demand and a new registered runtime retries safely",
      "TC-031 actual manual wake HTTP validates scope/fresh permissions, invokes registered Scheduler and accepts before allocation completion",
      "TC-031 a terminal Sales owner with positive queued demand fails closed without rewriting business facts"
    ]
  },
