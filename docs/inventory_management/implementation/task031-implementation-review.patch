+    if (!positive && index === 0 && Number(row.id) !== Number(staged.id)) throw inventoryError("VERSION_CONFLICT");
+  }
+  const balances = await service.locks.lockBalancesAfterLot(tx, { balances: ordered, now: service.time.nowMs() });
