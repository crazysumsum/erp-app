{
  "schema_version": "2.0",
  "module_id": "fulfillment-shipping-management",
  "environment": {
    "id": "fulfillment-isolated-test",
    "kind": "LOCAL_ISOLATED",
    "data_reference": "Synthetic fulfillment/shipping fixtures defined in 06_technical_test_cases.md and 07_uat_test_cases.md §2.2; no production data, no real customer address, phone, email or bank data",
    "authorization_ref": null
  },
  "permissions": {
    "product_write": [
      "IMPLEMENT"
    ],
    "test_script_write": [
      "IMPLEMENT",
      "TEST_AND_VERIFY"
    ],
    "docs_write": [
      "DESIGN_AND_PLAN",
      "IMPLEMENT",
      "TEST_AND_VERIFY",
      "REVIEW_AND_ALIGN"
    ],
    "isolated_data_write": [
      "IMPLEMENT",
      "TEST_AND_VERIFY"
    ],
    "schema_execute": [
      "IMPLEMENT"
    ],
    "deployment": [],
    "external_effects": [],
    "evidence_export": []
  },
  "runtime_policy": {
    "strategy": "ISOLATED",
    "required_resources": [
      "workspace",
      "mysql-schema",
      "web-port"
    ],
    "cleanup_owner": "Executing Phase owner"
  },
  "suites": [
    {
      "id": "lint",
      "kind": "LINT",
      "argv": [
        "npm",
        "run",
        "lint"
      ],
      "cwd": ".",
      "timeout_seconds": 600,
      "result_adapter": "EXIT_CODE",
      "result_path": "lint-result.json",
      "min_tests": 0,
      "max_skipped": 0,
      "stages": [
        "DEVELOPER"
      ],
      "required_case_ids": [],
      "tool_probes": [
        {
          "argv": [
            "node",
            "--version"
          ],
          "version_pattern": "^v(2[6-9]|[3-9]\\d)\\."
        }
      ],
      "side_effects": [
        "FILES"
      ],
      "env_keys": [],
      "redaction_env_keys": [
        "DB_PASSWORD"
      ]
    },
    {
      "id": "client-build",
      "kind": "BUILD",
      "argv": [
        "npm",
        "run",
        "build",
        "--workspace",
        "client"
      ],
      "cwd": ".",
      "timeout_seconds": 900,
      "result_adapter": "EXIT_CODE",
      "result_path": "client-build-result.json",
      "min_tests": 0,
      "max_skipped": 0,
      "stages": [
        "DEVELOPER"
      ],
      "required_case_ids": [],
      "tool_probes": [
        {
          "argv": [
            "node",
            "--version"
          ],
          "version_pattern": "^v(2[6-9]|[3-9]\\d)\\."
        }
      ],
      "side_effects": [
        "FILES"
      ],
      "env_keys": [],
      "redaction_env_keys": [
        "DB_PASSWORD"
      ]
    },
    {
      "id": "security-audit",
      "kind": "LINT",
      "argv": [
        "npm",
        "run",
        "security:audit"
      ],
      "cwd": ".",
      "timeout_seconds": 600,
      "result_adapter": "EXIT_CODE",
      "result_path": "security-audit-result.json",
      "min_tests": 0,
      "max_skipped": 0,
      "stages": [
        "DEVELOPER"
      ],
      "required_case_ids": [],
      "tool_probes": [
        {
          "argv": [
            "node",
            "--version"
          ],
          "version_pattern": "^v(2[6-9]|[3-9]\\d)\\."
        }
      ],
      "side_effects": [
        "FILES"
      ],
      "env_keys": [],
      "redaction_env_keys": [
        "DB_PASSWORD"
      ]
    },
    {
      "id": "fulfillment-technical",
      "kind": "INTEGRATION",
      "argv": [
        "node",
        "--test",
        "--import",
        "./server/test-support/testEnv.js",
        "--test-reporter=junit",
        "--test-reporter-destination={run_dir}/fulfillment-technical.xml",
        "server/test"
      ],
      "cwd": ".",
      "timeout_seconds": 3600,
      "result_adapter": "JUNIT",
      "result_path": "fulfillment-technical.xml",
      "min_tests": 1,
      "max_skipped": 0,
      "stages": [
        "DEVELOPER",
        "TECHNICAL",
        "REGRESSION"
      ],
      "required_case_ids": [
        "TC-001",
        "TC-002",
        "TC-003",
        "TC-004",
        "TC-005",
        "TC-006",
        "TC-007",
        "TC-008",
        "TC-009",
        "TC-010",
        "TC-011",
        "TC-012"
      ],
      "tool_probes": [
        {
          "argv": [
            "node",
            "--version"
          ],
          "version_pattern": "^v(2[6-9]|[3-9]\\d)\\."
        },
        {
          "argv": [
            "mysql",
            "--version"
          ],
          "version_pattern": "(?i)mysql"
        }
      ],
      "side_effects": [
        "FILES",
        "ISOLATED_DATA"
      ],
      "env_keys": [
        "DB_HOST",
        "DB_PORT",
        "DB_USER",
        "DB_PASSWORD",
        "DB_NAME",
        "DB_INTEGRATION_TESTS"
      ],
      "redaction_env_keys": [
        "DB_PASSWORD"
      ]
    }
  ],
  "ci": {
    "provider": "GitHub Actions (.github/workflows/ci.yml)",
    "required_checks": [
      "Dependency audit",
      "Lint",
      "Test (server + client, MySQL integration)",
      "Build frontend"
    ]
  },
  "acceptance": {
    "business_required": true,
    "release_approval_required": true,
    "require_clean_candidate": true
  },
  "evidence": {
    "directory": "evidence",
    "max_report_bytes": 2097152,
    "allow_export": false
  }
}
