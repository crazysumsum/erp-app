{
  "schema_version": "2.0",
  "module_id": "business-master",
  "environment": {
    "id": "business-master-isolated-test",
    "kind": "LOCAL_ISOLATED",
    "data_reference": "Synthetic Currency, Payment Term and consumer-reference fixtures defined in 06_technical_test_cases.md; no production data",
    "authorization_ref": "2026-09-14 user request: 進入 FULL_LIFECYCLE; synthetic isolated local runtime only"
  },
  "permissions": {
    "product_write": ["IMPLEMENT"],
    "test_script_write": ["IMPLEMENT","TEST_AND_VERIFY"],
    "docs_write": ["DESIGN_AND_PLAN","IMPLEMENT","TEST_AND_VERIFY","REVIEW_AND_ALIGN"],
    "isolated_data_write": ["IMPLEMENT","TEST_AND_VERIFY"],
    "schema_execute": ["IMPLEMENT"],
    "deployment": [],"external_effects": [],"evidence_export": []
  },
  "runtime_policy": {
    "strategy": "ISOLATED",
    "required_resources": ["workspace","mysql-schema","server-port","client-port","playwright-profile"],
    "cleanup_owner": "Executing Phase owner"
  },
  "suites": [
    {
      "id":"lint","kind":"LINT","argv":["npm","run","lint"],"cwd":".","timeout_seconds":600,
      "result_adapter":"EXIT_CODE","result_path":"lint-result.json","min_tests":0,"max_skipped":0,"stages":["DEVELOPER"],"required_case_ids":[],
      "tool_probes":[{"argv":["node","--version"],"version_pattern":"^v26\\."},{"argv":["npm","--version"],"version_pattern":"^[0-9]+\\."}],
      "side_effects":["FILES"],"env_keys":[],"redaction_env_keys":["DB_PASSWORD"]
    },
    {
      "id":"client-build","kind":"BUILD","argv":["npm","run","build","--workspace","client"],"cwd":".","timeout_seconds":900,
      "result_adapter":"EXIT_CODE","result_path":"client-build-result.json","min_tests":0,"max_skipped":0,"stages":["DEVELOPER"],"required_case_ids":[],
      "tool_probes":[{"argv":["node","--version"],"version_pattern":"^v26\\."}],"side_effects":["FILES"],"env_keys":[],"redaction_env_keys":["DB_PASSWORD"]
    },
    {
      "id":"business-master-server","kind":"INTEGRATION",
      "argv":["node","--test","--import","./server/test-support/testEnv.js","--test-reporter=junit","--test-reporter-destination={run_dir}/business-master-server.xml","server/test/business-master/*.test.js"],
      "cwd":".","timeout_seconds":3600,"result_adapter":"JUNIT","result_path":"business-master-server.xml","min_tests":15,"max_skipped":0,
      "stages":["DEVELOPER","TECHNICAL","REGRESSION"],
      "required_case_ids":["TC-001","TC-002","TC-003","TC-004","TC-005","TC-006","TC-007","TC-008","TC-009","TC-010","TC-011","TC-012","TC-013","TC-014","TC-015"],
      "tool_probes":[{"argv":["node","--version"],"version_pattern":"^v26\\."},{"argv":["mysql","--version"],"version_pattern":"(?i)mysql"}],
      "side_effects":["FILES","ISOLATED_DATA"],"env_keys":["DB_HOST","DB_PORT","DB_USER","DB_PASSWORD","DB_NAME","DB_INTEGRATION_TESTS"],"redaction_env_keys":["DB_PASSWORD"]
    },
    {
      "id":"business-master-client-ui","kind":"UI",
      "argv":["npm","test","--workspace","client","--","--config","test/business-master/vitest.config.js","--reporter=junit","--outputFile={run_dir}/business-master-client-ui.xml"],
      "cwd":".","timeout_seconds":1800,"result_adapter":"JUNIT","result_path":"business-master-client-ui.xml","min_tests":1,"max_skipped":0,
      "stages":["DEVELOPER","TECHNICAL","REGRESSION"],"required_case_ids":["TC-016"],
      "tool_probes":[{"argv":["node","--version"],"version_pattern":"^v26\\."}],"side_effects":["FILES"],"env_keys":[],"redaction_env_keys":["DB_PASSWORD"]
    },
    {
      "id":"business-master-browser","kind":"UI","argv":["npx","playwright","test","--config","client/e2e/business-master/playwright.config.js"],
      "cwd":".","timeout_seconds":7200,"result_adapter":"JUNIT","result_path":"business-master-browser.xml","min_tests":1,"max_skipped":0,
      "stages":["DEVELOPER","TECHNICAL","REGRESSION"],"required_case_ids":["TC-017"],
      "tool_probes":[{"argv":["node","--version"],"version_pattern":"^v26\\."}],"side_effects":["FILES","ISOLATED_DATA"],
      "env_keys":["DB_HOST","DB_PORT","DB_USER","DB_PASSWORD","DB_NAME","DB_INTEGRATION_TESTS"],"redaction_env_keys":["DB_PASSWORD"]
    },
    {
      "id":"business-master-performance","kind":"PERFORMANCE",
      "argv":["node","server/scripts/runBusinessMasterPerformanceAcceptance.js","--output","{run_dir}/business-master-performance.json"],
      "cwd":".","timeout_seconds":7200,"result_adapter":"HARNESS_JSON","result_path":"business-master-performance.json","min_tests":1,"max_skipped":0,
      "stages":["DEVELOPER","TECHNICAL","REGRESSION"],"required_case_ids":["TC-018"],
      "tool_probes":[{"argv":["node","--version"],"version_pattern":"^v26\\."},{"argv":["mysql","--version"],"version_pattern":"(?i)mysql"}],
      "side_effects":["FILES","ISOLATED_DATA"],"env_keys":["DB_HOST","DB_PORT","DB_USER","DB_PASSWORD","DB_NAME","DB_INTEGRATION_TESTS"],"redaction_env_keys":["DB_PASSWORD"]
    },
    {
      "id":"business-master-recovery","kind":"ACCEPTANCE",
      "argv":["node","server/scripts/runBusinessMasterRecoveryAcceptance.js","--output","{run_dir}/business-master-recovery.json"],
      "cwd":".","timeout_seconds":18000,"result_adapter":"HARNESS_JSON","result_path":"business-master-recovery.json","min_tests":1,"max_skipped":0,
      "stages":["DEVELOPER","TECHNICAL","REGRESSION"],"required_case_ids":["TC-019"],
      "tool_probes":[{"argv":["node","--version"],"version_pattern":"^v26\\."},{"argv":["mysql","--version"],"version_pattern":"(?i)mysql"}],
      "side_effects":["FILES","ISOLATED_DATA"],"env_keys":["DB_HOST","DB_PORT","DB_USER","DB_PASSWORD","DB_NAME","DB_INTEGRATION_TESTS"],"redaction_env_keys":["DB_PASSWORD"]
    },
    {
      "id":"business-master-consumer-contract","kind":"INTEGRATION",
      "argv":["node","--test","--import","./server/test-support/testEnv.js","--test-reporter=junit","--test-reporter-destination={run_dir}/business-master-consumer-contract.xml","server/test/business-master/consumer-contract/*.test.js"],
      "cwd":".","timeout_seconds":3600,"result_adapter":"JUNIT","result_path":"business-master-consumer-contract.xml","min_tests":1,"max_skipped":0,
      "stages":["DEVELOPER","TECHNICAL","REGRESSION"],"required_case_ids":["TC-020"],
      "tool_probes":[{"argv":["node","--version"],"version_pattern":"^v26\\."},{"argv":["mysql","--version"],"version_pattern":"(?i)mysql"}],
      "side_effects":["FILES","ISOLATED_DATA"],"env_keys":["DB_HOST","DB_PORT","DB_USER","DB_PASSWORD","DB_NAME","DB_INTEGRATION_TESTS"],"redaction_env_keys":["DB_PASSWORD"]
    },
    {
      "id":"business-master-uat-browser","kind":"UAT","argv":["npx","playwright","test","--config","client/e2e/business-master/playwright.config.js","--project","uat"],
      "cwd":".","timeout_seconds":7200,"result_adapter":"JUNIT","result_path":"business-master-uat-browser.xml","min_tests":9,"max_skipped":0,
      "stages":["UAT"],"required_case_ids":["UAT-001","UAT-002","UAT-003","UAT-004","UAT-005","UAT-006","UAT-007","UAT-008","UAT-009"],
      "tool_probes":[{"argv":["node","--version"],"version_pattern":"^v26\\."}],"side_effects":["FILES","ISOLATED_DATA"],
      "env_keys":["DB_HOST","DB_PORT","DB_USER","DB_PASSWORD","DB_NAME","DB_INTEGRATION_TESTS"],"redaction_env_keys":["DB_PASSWORD"]
    }
  ],
  "ci": {"provider":"GitHub Actions","required_checks":["Dependency audit","Lint","Test (server + client, MySQL integration)","Build frontend"]},
  "acceptance": {"business_required":true,"release_approval_required":true,"require_clean_candidate":true},
  "evidence": {"directory":"evidence","max_report_bytes":2097152,"allow_export":false}
}
