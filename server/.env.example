# Application environment. Affects response validation and log verbosity.
NODE_ENV=development

APP_PORT=3000
APP_HOST=127.0.0.1
APP_TIME_ZONE=Asia/Hong_Kong
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=30000
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=false
ENFORCE_HTTPS=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=erp_user
DB_PASSWORD=erp_password
DB_NAME=erp_dev
DB_QUERY_TIMEOUT_MS=10000
DB_TRANSACTION_TIMEOUT_MS=20000
DB_ACQUIRE_TIMEOUT_MS=5000
# Optional for local MySQL installations that use a Unix socket.
DB_SOCKET_PATH=
# Enable TLS for the MySQL connection. Set to true whenever DB_HOST points at
# anything other than localhost, or credentials and query data travel in the clear.
DB_SSL_ENABLED=false
# PEM contents of the CA certificate, when the server's cert isn't already
# trusted by Node's built-in CA store (common for RDS, Cloud SQL, etc).
# Multi-line values are not supported by env files, so escape newlines as \n.
DB_SSL_CA=
# Set to false only to accept a self-signed certificate in local testing.
# Leaving this true in production is required to prevent MITM attacks.
DB_SSL_REJECT_UNAUTHORIZED=true

# JWT settings. JWT_SECRET is required in EVERY environment - the application
# refuses to start without it. There is deliberately no built-in default: a secret
# committed to version control lets anyone mint tokens with any role.
# Generate one with: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=erp-api
JWT_AUDIENCE=erp-web
# 短效期靠設備綁定的自動續期撐著（見 docs/device-binding-auth.md）：前端會在
# 到期前背景換發，所以使用者感覺不到，而被偷 token 的存活時間只有 15 分鐘。
JWT_EXPIRES_IN=15m
# 一條 session 從登入起最多能活多久，不管中間背景續期過幾次。到期就必須重新
# 輸入帳號密碼——續期推不動這個上限。與 JWT_EXPIRES_IN 同格式（整數加單位）。
JWT_SESSION_MAX_AGE=8h
JWT_CLOCK_TOLERANCE_SECONDS=5

# Item Management 的部署／資源設定（見 config/item.js）。全部選填，留空使用
# config/item.js 內的預設值。固定的商業口徑（HKD、tax_not_applicable、狀態、
# 追蹤政策等）定義在 src/modules/item/itemConstants.js，不透過環境變數提供，
# 也不應該加在這裡——那些是已簽核的業務決策，不是部署設定。
ITEM_CATEGORY_MAX_DEPTH=8
# 相對路徑以 server 目錄為基準；正式環境通常會指向持久化 volume。
ITEM_MEDIA_DIRECTORY=storage/items
ITEM_IMAGE_MAX_BYTES=5242880
ITEM_ATTACHMENT_MAX_BYTES=10485760
ITEM_MEDIA_ORPHAN_GRACE_MS=86400000
ITEM_IMPORT_MAX_ROWS=10000
ITEM_IMPORT_BATCH_SIZE=200
ITEM_IMPORT_TRANSACTION_TIMEOUT_MS=120000
# Supplier Bank key rings. 由 TASK-034 起 Bank capability 已經部署，所以呢四個值
# **唔再係選填** —— 缺任何一個，應用會喺 startup 拒絕起，唔會只係關閉 bank endpoint
# 照常啟動（設計 §1700：否則個失敗會拖到付款流程先至出現）。
#
# 兩組 ring 係分開嘅，而且唔可以共用同一條 key：encryption ring 加密帳號，lookup ring
# 計 blind index，佢哋輪替嘅代價唔同。每個值都係一個 JSON object，key ID 對 base64，
# 而每條 base64 要 decode 到啱啱 32 bytes；activeKeyId 一定要喺自己嗰個 ring 入面。
#
# 產生一組（本機用，唔好 commit 真 key）：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# 例：
#   SUPPLIER_BANK_ACTIVE_KEY_ID=local-enc-1
#   SUPPLIER_BANK_ENCRYPTION_KEYS={"local-enc-1":"<32 bytes base64>"}
SUPPLIER_BANK_ACTIVE_KEY_ID=
SUPPLIER_BANK_ENCRYPTION_KEYS=
SUPPLIER_BANK_LOOKUP_ACTIVE_KEY_ID=
SUPPLIER_BANK_LOOKUP_KEYS=

# Customer bank capability remains disabled when all four values are empty.
# When enabled, both independent 32-byte base64 key rings and active IDs are required.
# Values must match the Supplier rings above; AAD separates each owner domain.
CUSTOMER_BANK_ACTIVE_KEY_ID=
CUSTOMER_BANK_ENCRYPTION_KEYS=
CUSTOMER_BANK_LOOKUP_ACTIVE_KEY_ID=
CUSTOMER_BANK_LOOKUP_KEYS=
CUSTOMER_ATTACHMENT_GENERAL_ROOT=/var/lib/erp/customer-attachments/general
CUSTOMER_ATTACHMENT_BANK_ROOT=/var/lib/erp/customer-attachments-bank/general
CUSTOMER_ATTACHMENT_TEMP_ROOT=/var/lib/erp/customer-attachments-tmp/general
CUSTOMER_ATTACHMENT_MAX_FILE_BYTES=20971520
CUSTOMER_ATTACHMENT_ORPHAN_GRACE_MS=86400000
CUSTOMER_MALWARE_SCANNER_MODE=clamd
CUSTOMER_MALWARE_SCANNER_HOST=127.0.0.1
CUSTOMER_MALWARE_SCANNER_PORT=3310
CUSTOMER_MALWARE_SCANNER_TIMEOUT_MS=15000
SUPPLIER_DUPLICATE_NAME_THRESHOLD=0.85
SUPPLIER_IMPORT_MAX_FILE_BYTES=10485760
SUPPLIER_IMPORT_MAX_ROWS=10000
SUPPLIER_IMPORT_FILE_RETENTION_DAYS=365
